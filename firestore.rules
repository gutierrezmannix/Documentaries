rules_version = '2';

// Paste this whole file into: Firebase console > Firestore Database > Rules > Publish
// Change the email below to the same ADMIN_EMAIL you put in firebase-config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "carlosgutierrezmannix@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Videos: anyone can watch, only you can post, edit, or delete.
    match /videos/{videoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // Reactions: anyone can add one, but ONLY from the preset list.
      // No free text is accepted, and nobody but you can edit or delete.
      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(["type", "createdAt"])
          && request.resource.data.type in [
               "heart", "like", "great", "amazing", "supergood",
               "learned", "discuss", "boring", "moreaction"
             ]
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Traffic: anonymous visit and video-watch counts. Anyone can add one,
    // only in this exact shape; only you can read or delete them.
    match /visits/{visitId} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(["kind", "page", "at"])
        && request.resource.data.keys().hasOnly(["kind", "page", "video", "at"])
        && request.resource.data.kind in ["view", "watch"]
        && request.resource.data.page is string
        && request.resource.data.page.matches("[a-z0-9-]{1,30}")
        && (!("video" in request.resource.data)
            || (request.resource.data.video is string
                && request.resource.data.video.matches("[A-Za-z0-9_-]{1,40}")))
        && request.resource.data.at == request.time;
      allow update: if false;
    }
  }
}
